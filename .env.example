# ==============================================================================
# Blogger Engine - Production Environment Configuration
# Canonical Architecture: Experiment 4 (BGE + BM25 + RRF + Cross-Encoder L-6)
# ==============================================================================

# LLM Provider Configuration
# Supported providers: groq, gemini, openai, ollama (or any OpenAI-compatible endpoint)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=

# Canonical Embedding & Retrieval Configuration (Experiment 4)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
FAISS_INDEX_PATH=indexes/faiss_chunked_bge_dedup.index
SQLITE_DB_PATH=data/blogger_dedup.db
BM25_CACHE_PATH=indexes/bm25_chunked_dedup.pkl
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
TOP_K=3

# Hybrid Retrieval Parameters
CANDIDATE_DEPTH=20
RERANK_DEPTH=20
RRF_K=60
DOC_DEDUP=true
USE_RERANKER=true

# Calibrated Confidence Refusal Threshold
# Calibrated on held-out dataset: 100% in-domain acceptance, 0 false refusals
SIMILARITY_THRESHOLD=0.65

# Application Server & Logging Configuration
# Ephemeral-safe: set to false if running on a read-only container
ENABLE_QUERY_LOGGING=true
HOST=0.0.0.0
PORT=8000
