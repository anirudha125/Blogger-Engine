# ==============================================================================
# Blogger Engine - Git Ignore Rules
# ==============================================================================

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Python Bytecode & Runtime Caches
**/__pycache__/
**/*.py[cod]
*$py.class
.Python

# Pytest & Coverage Caches
.pytest_cache/
**/.pytest_cache/**
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Environment Configuration & Secrets (Never commit live secrets)
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*

# Operating System & IDE Files
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

